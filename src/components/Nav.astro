---
import { asset } from '../utils/asset';
const links = [
  { href: '/', label: 'Home' },
  { href: '/story', label: 'Our Story' },
  { href: '/menu', label: 'Menu' },
  { href: '/shop', label: 'Shop' },
  { href: '/visit', label: 'Visit' },
];
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<nav class="sticky top-0 z-40 bg-cream/90 backdrop-blur border-b border-ink/10">
  <div class="container-gallery flex items-center justify-between py-4">
    <a href={asset('/')} class="font-display text-xl tracking-tight">
      Victor Emporium <span class="font-accent italic text-sm text-ink/75">Est. 1950</span>
    </a>

    <button
      id="mobile-menu-button"
      class="md:hidden p-2 -m-2"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <ul class="hidden md:flex gap-8 text-sm uppercase tracking-widest">
      {links.map(l => (
        <li>
          <a
            href={asset(l.href)}
            class:list={[
              'hover:text-emporium-red transition-colors',
              pathname === `${base}${l.href}`.replace(/\/$/, '') + (l.href === '/' ? '/' : '') && 'text-emporium-red'
            ]}
          >{l.label}</a>
        </li>
      ))}
    </ul>
  </div>

  <ul id="mobile-menu" class="hidden md:hidden flex-col gap-1 px-6 pb-4 text-sm uppercase tracking-widest border-t border-ink/10 bg-cream/95">
    {links.map(l => (
      <li>
        <a
          href={asset(l.href)}
          class:list={[
            'block py-3 hover:text-emporium-red transition-colors',
            pathname === `${base}${l.href}`.replace(/\/$/, '') + (l.href === '/' ? '/' : '') && 'text-emporium-red'
          ]}
        >{l.label}</a>
      </li>
    ))}
  </ul>
</nav>

<script is:inline>
  (function () {
    const btn = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', () => {
      const wasHidden = menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      menu.classList.toggle('flex');
      btn.setAttribute('aria-expanded', wasHidden ? 'true' : 'false');
    });
  })();
</script>
