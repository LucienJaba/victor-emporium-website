---
import { visit } from '../data/visit';
---
<div class="border border-emporium-red/30 bg-cream p-8 text-center">
  <p class="font-accent italic text-emporium-red text-lg">Form coming soon</p>
  <p class="mt-4 text-ink/80 leading-relaxed">
    The contact form will go live once we connect it to the Emporium's inbox. In the meantime, the best way to reach us is:
  </p>
  <div class="mt-6 space-y-2 text-lg">
    <p>
      <a href={`tel:${visit.phone.replace(/[^0-9]/g, '')}`} class="hover:text-emporium-red">{visit.phone}</a>
    </p>
    <p>
      <a href={`mailto:${visit.email}`} class="hover:text-emporium-red">{visit.email}</a>
    </p>
  </div>
  <p class="mt-6 text-xs uppercase tracking-widest text-ink/50">
    [Phone &amp; email are placeholders pending Adam &amp; Lee's confirmation]
  </p>
</div>
